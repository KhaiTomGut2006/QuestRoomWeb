MONGODB_URI=mongodb://127.0.0.1:27017/quest-room-web
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_DEMO_GUESTS=true
# WebSocket is the production default. Only enable polling while diagnosing proxy issues.
NEXT_PUBLIC_SOCKET_ALLOW_POLLING=false
SOCKET_ALLOW_POLLING=false
# Shared secret for admin/dashboard callbacks into QuestRoomWeb APIs.
# Set the same value in the dashboard/bot service that calls /api/player/challenge/sync.
GAME_API_TOKEN=replace-with-a-long-random-token
LEVEL_CACHE_TTL_MS=300000
LEVEL_CONFIG_CACHE_TTL_MS=300000
NPC_CYCLE_RESTORE_JITTER_MS=30000
NPC_CYCLE_RESTORE_CACHE_TTL_MS=15000
TEMPLATE_CACHE_TTL_MS=300000
RANKING_CACHE_TTL_MS=60000
ROOM_PLAYERS_LIMIT=200
GLOBAL_POSTS_CACHE_TTL_MS=15000
SOCIAL_POST_FEED_LIMIT=50
SOCIAL_POSTS_QUERY_MAX_TIME_MS=3000
SOCIAL_POST_BACKFILL_MEMBER_LIMIT=100
SOCIAL_POST_BACKFILL_INTERVAL_MS=300000
FRIENDS_CACHE_TTL_MS=60000
FRIENDS_STALE_CACHE_TTL_MS=900000

# Keep disabled in production unless actively testing dev tools.
ENABLE_DEV_TOOLS=false
# Comma-separated Discord IDs allowed to use production dev tools.
DEV_TOOL_DISCORD_IDS=
# Google Sheet attendance service used by the Friends and Global Quest views.
# Override this when running a local attendance bot.
BOT_SERVER_URL=https://api.hamsterquest.com/attendance
BOT_SERVER_TIMEOUT_MS=20000
# Optional: use Cloudflare R2 for direct browser uploads (preferred — CDN-backed, no server relay).
# Copy these from nuutorbot-new's .env. Files land under npc-quests/<discordId>/...
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional: use a public Vercel Blob store for direct browser uploads (fallback if R2 not set).
# Without both R2 and this token, local/dev can use MongoDB GridFS.
# Production requires direct upload unless ALLOW_GRIDFS_UPLOADS=true is set intentionally.
BLOB_READ_WRITE_TOKEN=
ALLOW_GRIDFS_UPLOADS=false
GRIDFS_MAX_UPLOAD_MB=2
# Use this only when deploying under a path such as https://api.hamsterquest.com/questroom
# NEXT_PUBLIC_BASE_PATH=/questroom
# PORT=3001
