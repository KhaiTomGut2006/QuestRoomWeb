MONGODB_URI=mongodb://127.0.0.1:27017/quest-room-web
# Optional explicit database name. Recommended for Atlas URIs without a database path.
MONGODB_DB=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_DEMO_GUESTS=true

# Keep disabled in production unless actively testing dev tools.
ENABLE_DEV_TOOLS=false
# Comma-separated Discord IDs allowed to use production dev tools.
DEV_TOOL_DISCORD_IDS=
# Google Sheet attendance service used by the Friends and Global Quest views.
# Override this when running a local attendance bot.
BOT_SERVER_URL=https://api.hamsterquest.com/attendance
BOT_SERVER_TIMEOUT_MS=20000
# Optional: use Cloudflare R2 for direct browser uploads (preferred — CDN-backed, no server relay).
# Copy these from nuutorbot-new's .env. Files land under npc-quests/<discordId>/...
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional: use a public Vercel Blob store for direct browser uploads (fallback if R2 not set).
# Without both R2 and this token, NPC quest evidence is stored in MongoDB GridFS.
BLOB_READ_WRITE_TOKEN=
# Optional internal metrics endpoint: GET /internal/metrics
# Production requests must send Authorization: Bearer <METRICS_TOKEN>.
METRICS_ENABLED=true
METRICS_TOKEN=

# Optional dashboard write protection. Configure the same token in the dashboard.
# Keep blank during rollout to preserve the current dashboard behavior.
DASHBOARD_API_TOKEN=
# Restrict browser calls to the deployed dashboard origin when known.
DASHBOARD_ALLOWED_ORIGIN=

# Rollout flags for performance migrations. Keep disabled until each phase is deployed.
SOCIAL_READ_V2=false
SOCIAL_DUAL_WRITE=false
SOCKET_DELTA_V2=false
SOCKET_PRESENCE_GRACE_MS=15000
# Maximum offline avatars returned by /api/player/room for each stage.
OFFLINE_ROOM_PLAYER_LIMIT=100
# Keep true for one rollout while old browser bundles are still cached, then set false.
ALLOW_LEGACY_COOLDOWN_SOCKET=true
REDIS_ADAPTER_ENABLED=false
DEFER_BGM_LOAD=true
# Use this only when deploying under a path such as https://api.hamsterquest.com/questroom
# NEXT_PUBLIC_BASE_PATH=/questroom
# PORT=3001
